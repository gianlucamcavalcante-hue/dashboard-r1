# Copie para .env.local (local) ou configure na Vercel (produção).

# Conexão com o banco Supabase (a mesma do app antigo do Streamlit).
DATABASE_URL=

# Senha para entrar no painel. Se ficar vazia, o painel abre sem senha (só no computador).
DASHBOARD_PASSWORD=

# Segredo para assinar o login: qualquer texto longo e aleatório.
SESSION_SECRET=
